{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMind RS",
  "version": "0.4.0",
  "identifier": "app.xmindrs.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "XMind RS",
        "width": 1410,
        "height": 829,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "devtools": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png"],
    "shortDescription": "Memory-light mind maps, XMind compatible",
    "longDescription": "A Rust/Tauri 2 reimplementation of the XMind mind map editor. Uses the OS WebView instead of bundling Chromium, and loads every non-essential feature on demand."
  }
}
